{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piloso",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "run_worker_first": ["/index.html"],
  },
  "compatibility_flags": ["nodejs_compat", "assets_navigation_has_no_effect"],
}
