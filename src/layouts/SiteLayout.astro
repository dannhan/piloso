---
import '../styles/global.css';
import type { Locale } from '../i18n/useTranslations';

interface Props {
  title: string;
  description: string;
  lang: Locale;
}

const { title, description, lang } = Astro.props;
const canonical = new URL(lang === 'id' ? '/' : '/en/', Astro.site);
const english = new URL('/en/', Astro.site);
const indonesian = new URL('/', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={indonesian} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="x-default" href={indonesian} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Instrument+Sans:wght@400;500;600&family=Saira+Stencil+One&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
