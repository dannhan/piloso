---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE } from '../config/site';
import type { Locale } from '../i18n/useTranslations';
import type { LocaleMessages } from '../i18n/types';

interface Props {
  messages: LocaleMessages;
  locale: Locale;
}

const { messages, locale } = Astro.props;
const targetLocale: Locale = locale === 'id' ? 'en' : 'id';
const switchText = locale === 'id' ? 'EN' : 'ID';
const switchName = locale === 'id' ? 'English' : 'Bahasa Indonesia';
---

<nav class="nav">
  <a href="#hero" class="brand">
    <img src="/assets/logo/logo-original.jpeg" alt={messages.nav.logoAlt} />
    <span>{SITE.brand}</span>
  </a>
  <ul class="links" id="navLinks">
    {messages.nav.links.map((link) => (
      <li>
        <a href={link.href}>{link.label}</a>
      </li>
    ))}
  </ul>
  <button class="btn btn-solid" onclick="openSampleModal()">
    {messages.actions.requestSample}
  </button>
  <a
    class="language-switch"
    href={getRelativeLocaleUrl(targetLocale)}
    hreflang={targetLocale}
    lang={targetLocale}
    aria-label={`${switchText}: ${switchName}`}
  >
    {switchText}
  </a>
  <button
    class="menu-toggle"
    id="menuToggle"
    type="button"
    aria-label={messages.nav.menuLabel}
    aria-controls="navLinks"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>
