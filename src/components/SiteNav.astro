---
import { SITE } from '../config/site';
import type { Locale } from '../i18n/useTranslations';
import type { LocaleMessages } from '../i18n/types';

interface Props {
  messages: LocaleMessages;
  locale: Locale;
}

const { messages, locale } = Astro.props;
---

<nav class="nav">
  <a href="#hero" class="brand">
    <img src="/assets/logo/logo-original.jpeg" alt={messages.nav.logoAlt} />
    <span>{SITE.brand}</span>
  </a>
  <ul class="links" id="navLinks">
    {messages.nav.links.map((link) => (
      <li>
        <a href={link.href}>{link.label}</a>
      </li>
    ))}
  </ul>
  <button class="btn btn-solid" onclick="openSampleModal()">
    {messages.actions.requestSample}
  </button>
  <a
    class="language-switch"
    href={locale === 'id' ? '/en/' : '/'}
    hreflang={locale === 'id' ? 'en' : 'id'}
    lang={locale === 'id' ? 'en' : 'id'}
    aria-label={messages.nav.languageSwitchLabel}
  >
    {locale === 'id' ? 'EN' : 'ID'}
  </a>
  <button
    class="menu-toggle"
    id="menuToggle"
    aria-label={messages.nav.menuLabel}
    aria-expanded="false"
  >
    <span></span>
    <span></span>
  </button>
</nav>
