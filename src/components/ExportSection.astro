---
import type { LocaleMessages } from '../i18n/types';

interface Props {
  messages: LocaleMessages;
}

const { messages } = Astro.props;
---

<section class="sec dark" id="export" data-marker={messages.export.marker}>
  <div class="split">
    <div>
      <h2>{messages.export.title}</h2>
      <p class="lead">{messages.export.lead}</p>
      <dl class="terms">
        {messages.export.terms.map((term) => (
          <div>
            <dt>{term.label}</dt>
            <dd set:html={term.value} />
          </div>
        ))}
      </dl>
    </div>
    <ol class="steps">
      {messages.export.steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
