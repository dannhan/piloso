---
import type { LocaleMessages } from '../i18n/types';

interface Props {
  messages: LocaleMessages;
}

const { messages } = Astro.props;
---

<section class="band why">
  {messages.valueProps.map((item) => (
    <div>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
    </div>
  ))}
</section>
