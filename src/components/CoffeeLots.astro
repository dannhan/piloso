---
import { withBrand } from '../config/site';
import type { LocaleMessages } from '../i18n/types';
interface Props {
  messages: LocaleMessages;
}

const { messages } = Astro.props;
---

<section class="sec sec-alt" id="coffees">
  <p class="section-marker">{messages.coffees.marker}</p>
  <h2>{messages.coffees.title}</h2>
  <p class="lead">{messages.coffees.description}</p>
  <div class="table-wrap">
    <table class="lots">
      <thead>
        <tr>
          {messages.coffees.columns.map((column, index) => (
            <th>
              {index === messages.coffees.columns.length - 1 ? (
                <span class="sr">{column}</span>
              ) : (
                column
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {messages.coffees.lots.map((lot) => (
          <tr>
            <td data-label={messages.coffees.columns[0]}>
              <strong>{withBrand(lot.name)}</strong>
              {lot.tag && (
                <>
                  {' '}
                  <span class="fav">{lot.tag}</span>
                </>
              )}
              <span class="proc">{lot.process}</span>
              <span class="notes">{lot.notes}</span>
            </td>
            <td data-label={messages.coffees.columns[1]}>
              <span class="lot-value">{lot.altitude}</span>
            </td>
            <td data-label={messages.coffees.columns[2]}>
              <span class="lot-value">{lot.screen}</span>
            </td>
            <td data-label={messages.coffees.columns[3]}>
              <span class="lot-value">{lot.moisture}</span>
            </td>
            <td data-label={messages.coffees.columns[4]}>{lot.defects}</td>
            <td data-label={messages.coffees.columns[5]}>
              <button class="btn btn-line" onclick={`selectLotAndOpen('${withBrand(lot.name)}')`}>
                {messages.actions.requestSample}
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">{messages.coffees.note}</p>
</section>
