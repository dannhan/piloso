---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import HeroSection from '../components/HeroSection.astro';
import ValueBand from '../components/ValueBand.astro';
import OriginSection from '../components/OriginSection.astro';
import CoffeeLots from '../components/CoffeeLots.astro';
import ExportSection from '../components/ExportSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SampleModal from '../components/SampleModal.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { SITE } from '../config/site';
import { useTranslations } from '../i18n/useTranslations';

const messages = useTranslations('id');
---

<SiteLayout
  title={`${SITE.brand} — ${messages.meta.titleSuffix}`}
  description={messages.meta.description}
  lang="id"
>
  <SiteNav messages={messages} />
  <HeroSection messages={messages} />
  <ValueBand messages={messages} />
  <OriginSection messages={messages} />
  <CoffeeLots messages={messages} />
  <ExportSection messages={messages} />
  <ProcessSection messages={messages} />
  <PhilosophySection messages={messages} />
  <FaqSection messages={messages} />
  <FinalCta messages={messages} />
  <SiteFooter messages={messages} />
  <SampleModal messages={messages} />
  <FloatingWhatsApp messages={messages} />
  <script src="/script.js" is:inline></script>
</SiteLayout>
